<?xml version="1.0" encoding="utf-8"?>
<!--
  列表行，结构照 yetone/magpie 的 .row：
    左信号图标 │ 主标题 + 副标题（第二行）│ 右侧状态胶囊
  行间不画线——由 DividerDecoration 统一画 1px line_2，跟 magpie 一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- 左：信号强度条（4 格，用方块表示，比 dBm 直观） -->
    <LinearLayout
        android:id="@+id/signalBars"
        android:layout_width="22dp"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginEnd="13dp">

        <View
            android:id="@+id/bar1"
            android:layout_width="3dp"
            android:layout_height="6dp"
            android:layout_marginEnd="2dp"
            android:background="@color/green" />

        <View
            android:id="@+id/bar2"
            android:layout_width="3dp"
            android:layout_height="10dp"
            android:layout_marginEnd="2dp"
            android:background="@color/green" />

        <View
            android:id="@+id/bar3"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp"
            android:background="@color/green" />

        <View
            android:id="@+id/bar4"
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:background="@color/green" />
    </LinearLayout>

    <!-- 中：标题 + 副标题 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSID"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 副标题：加密 · dBm · 候选数，magpie 用「· 」连接的多段 meta -->
        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="WPA3 · -30 dBm · 库中 22 个候选"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 右：状态胶囊（背景 drawable 提供圆角，代码里用 backgroundTint 着色） -->
    <TextView
        android:id="@+id/kind"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_pill"
        android:text="需密码"
        android:textSize="11.5sp" />

</LinearLayout>