<?xml version="1.0" encoding="utf-8"?>
<!--
  布局语言借鉴 yetone/magpie（internal/gui/assets/app.css）：
   · 一个安静的表面：整页只有一个 bg 色，所有内容装进一张 card
   · 卡片高度随内容收缩（magpie 是网页，卡片 height:auto），所以整页可滚动
   · 卡片内用 1px 细线分隔行，而不是每行一张卡片
   · 控件是胶囊（pill），文字四级层次 fg / fg2 / muted / faint
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- ── 顶部栏：logo + 标题 + 右侧胶囊 ───────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:layout_marginEnd="9dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Walking WiFi"
                android:textColor="@color/fg"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRescan"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_pill"
                android:text="扫描"
                android:textColor="@color/fg_2"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── 说明 / 智能建议文字 ────────────────────────── -->
        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="自动扫网 · 依次试：公用常用密码 → 自带品牌库 → 后端密码库"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- ── 分段筛选（magpie 的 seg-track / seg-thumb）───── -->
        <LinearLayout
            android:id="@+id/segTrack"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_seg_track"
            android:padding="3dp">

            <TextView
                android:id="@+id/segAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_seg_thumb"
                android:text="全部"
                android:textColor="@color/fg"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/segOpen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="开放"
                android:textColor="@color/ctl_fg"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/segPass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="需密码"
                android:textColor="@color/ctl_fg"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ── 主卡片：高度随内容（同 magpie 的卡片）────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <!-- 空态 / 加载态：放在卡片内部 -->
            <LinearLayout
                android:id="@+id/emptyBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="44dp"
                android:paddingBottom="44dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◌"
                    android:textColor="@color/faint"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="还没有扫到网络"
                    android:textColor="@color/fg_2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/emptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="点右上角「扫描」，并确认系统定位已打开"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- 卡片底部：分隔线 + 计数（magpie 的 "Show 21 more" 位置）-->
            <View
                android:id="@+id/footerLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/line_2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/countText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 真实连接成功率：App 自己统计，不靠猜 -->
        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="还没试过"
            android:textColor="@color/muted"
            android:textSize="11.5sp" />

        <!-- ── 状态条：只在有话说的时候出现 ────────────────── -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/bg_pill"
            android:text="准备就绪"
            android:textColor="@color/fg_2"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <!-- ── 匿名贡献卡片：三层都没试出来时才出现 ──────────────
             设计意图：不要给用户「失败了」的挫败感，而是给一个
             「你能帮下一个人」的小任务。人愿意帮忙，不愿意被教育。 -->
        <LinearLayout
            android:id="@+id/contributeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="密码贴在墙上吗？"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="看一眼告诉我们，下一个人在这家店能省几分钟。完全匿名，不关联你的账号。"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/contributeInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:hint="输入墙上的密码"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:maxLength="63"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/faint"
                    android:textSize="14sp" />

                <!-- 用 TextView + bg_accent_pill，和底部「+ 录入」同一套做法。
                     之前用 MaterialButton 的 TonalButton 样式，在这个主题下
                     解析成了洋红色实心圆、文字看不见——不如直接沿用已有方案。 -->
                <TextView
                    android:id="@+id/btnContribute"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_accent_pill"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="贡献"
                    android:textColor="@color/accent_fg"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnContributeSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:text="不用了"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ── 体检报告：方案 A 的核心界面 ──────────────────── -->
        <LinearLayout
            android:id="@+id/checkupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <!-- 顶行：分数 + 等级 + 网络名 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/scoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="--"
                    android:textColor="@color/fg"
                    android:textSize="46sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="/100"
                    android:textColor="@color/faint"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/scoreGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="--"
                    android:textColor="@color/fg_2"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/checkupSsid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:ellipsize="middle"
                    android:maxWidth="150dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 一句话结论 -->
            <TextView
                android:id="@+id/verdictText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="@color/fg_2"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/line_2" />

            <!-- 四项分数据 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="信号"
                        android:textColor="@color/faint"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/mSignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加密"
                        android:textColor="@color/faint"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/mSecurity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="下载"
                        android:textColor="@color/faint"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/mSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="延迟"
                        android:textColor="@color/faint"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/mLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 建议 -->
            <TextView
                android:id="@+id/tipsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:lineSpacingExtra="3dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text=""
                android:textColor="@color/fg_2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ── 底部：pill 行（magpie 的 PROFILES 行）─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIBRARY"
                android:textColor="@color/faint"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/pillSeed"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_pill"
                android:text="种子库"
                android:textColor="@color/fg_2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/pillVerified"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_pill"
                android:text="已验证"
                android:textColor="@color/fg_2"
                android:textSize="12.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/pillAdd"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_accent_pill"
                android:text="+ 录入"
                android:textColor="@color/accent_fg"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="仅连公开公用 WiFi，请勿用于他人私有网络"
            android:textColor="@color/faint"
            android:textSize="10.5sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>