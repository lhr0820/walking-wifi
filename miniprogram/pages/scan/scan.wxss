.wrap {
  padding-bottom: 80rpx;
}

/* ── 扫描中 ─────────────────────────────── */
.scanning-bar {
  display: flex;
  align-items: center;
}

.spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #d8d8de;
  border-top-color: #4f46e5;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── 网络行 ─────────────────────────────── */
.net-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ececf0;
}

.signal {
  display: flex;
  align-items: flex-end;
  height: 40rpx;
  width: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bar {
  width: 7rpx;
  margin-right: 3rpx;
  background: #dcdce2;
  border-radius: 2rpx;
}

.bar.on {
  background: #4f46e5;
}

.net-main {
  flex: 1;
  min-width: 0;
}

.net-name {
  font-size: 29rpx;
  color: #1c1c21;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.net-sub {
  font-size: 22rpx;
  color: #85858d;
  margin-top: 6rpx;
}

.arrow {
  color: #b9b9c2;
  font-size: 30rpx;
}

/* 「复制」提示标签 */
.tag-copy {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #eeedfb;
  color: #4f46e5;
  border-radius: 12rpx;
  font-size: 23rpx;
  flex-shrink: 0;
}

/* ── 展开的密码卡片 ─────────────────────── */
.psk-panel {
  background: #fafafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 0 20rpx 0;
}

.psk-label {
  font-size: 23rpx;
  color: #85858d;
  text-align: center;
  margin-bottom: 8rpx;
}

/* 密码大字：一眼看清、能记、能长按复制 */
.psk-big {
  font-size: 52rpx;
  font-weight: 600;
  color: #1c1c21;
  letter-spacing: 3rpx;
  text-align: center;
  word-break: break-all;
  line-height: 1.3;
  padding: 12rpx 0 20rpx;
  /* 让长按选中更容易 */
  user-select: text;
  -webkit-user-select: text;
}

.psk-actions {
  display: flex;
  gap: 16rpx;
}

/* ── 分步骤指引 ─────────────────────────── */
.steps {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ececf0;
}

.steps-title {
  font-size: 24rpx;
  color: #4b4b53;
  margin-bottom: 14rpx;
}

.step {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #4b4b53;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.step:last-child {
  margin-bottom: 0;
}

.step-n {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #eeedfb;
  color: #4f46e5;
  border-radius: 50%;
  font-size: 21rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.collapse {
  text-align: center;
  font-size: 23rpx;
  color: #b9b9c2;
  padding: 18rpx 0 4rpx;
}