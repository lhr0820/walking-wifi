# 复制本文件为 keystore.properties 后填入自己的签名信息
# keystore.properties 已在 .gitignore 中，不会进版本库
#
# 用 scripts/gen-keystore.ps1 可一键生成随机密码的 keystore
# 警告：keystore 一旦丢失，就无法给已上架的应用推送更新
#
# storeFile 路径相对项目根目录
storeFile=release-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=walkingwifi
keyPassword=YOUR_KEY_PASSWORD
